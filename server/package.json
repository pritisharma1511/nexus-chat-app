{
  "name": "chat-app-server",
  "version": "1.0.0",
  "description": "Real-Time Chat App Backend with Node.js, Express, Socket.IO, and Redis",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.14",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/server/node_modules"
    ],
    "testRegex": "tests/.*\\.test\\.js$",
    "testTimeout": 15000
  }
}
